[gd_scene format=3]

[ext_resource type="Theme" path="res://game/ui/menu_theme.tres" id="theme"]
[ext_resource type="Script" path="res://game/ui/ProfilesPanel.gd" id="script"]
[ext_resource type="Script" path="res://game/ui/IconButton.gd" id="icon_button"]
[ext_resource type="Texture2D" path="res://game/ui/icons/x.svg" id="icon_x"]
[ext_resource type="Texture2D" path="res://game/ui/icons/plus.svg" id="icon_plus"]

[node name="ProfilesPanel" type="Panel"]
offset_right = 760.0
offset_bottom = 620.0
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 56)
layout_mode = 2

[node name="Title" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
text = "Who's playing?"
vertical_alignment = 1

[node name="Close_Button" type="Button" parent="Margin/VBox/Header"]
layout_mode = 2
text = "Close"
icon = ExtResource("icon_x")
script = ExtResource("icon_button")

[node name="Rows" type="VBoxContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 6

[node name="Note" type="Label" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.63, 0.67, 1)
vertical_alignment = 1
text_overrun_behavior = 3

[node name="Add_Button" type="Button" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
text = "Add player"
icon = ExtResource("icon_plus")
script = ExtResource("icon_button")

[connection signal="pressed" from="Margin/VBox/Header/Close_Button" to="." method="_on_close_pressed"]
[connection signal="pressed" from="Margin/VBox/Add_Button" to="." method="_start_typing" binds= [""]]
