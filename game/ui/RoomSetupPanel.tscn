[gd_scene format=3]

[ext_resource type="StyleBox" path="res://game/ui/menu_panel.tres" id="menu_panel"]
[ext_resource type="Theme" path="res://game/ui/menu_theme.tres" id="theme"]
[ext_resource type="Script" path="res://game/ui/RoomSetupPanel.gd" id="script"]

[node name="RoomSetupPanel" type="Panel"]
offset_right = 760.0
offset_bottom = 360.0
theme = ExtResource("theme")
theme_override_styles/panel = ExtResource("menu_panel")
script = ExtResource("script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 56)
layout_mode = 2
theme_type_variation = &"TitleLabel"
vertical_alignment = 1

[node name="Body" type="Label" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
alignment = 2
theme_override_constants/separation = 24

[node name="Secondary_Button" type="Button" parent="Margin/VBox/Buttons"]
custom_minimum_size = Vector2(300, 64)
layout_mode = 2

[node name="Primary_Button" type="Button" parent="Margin/VBox/Buttons"]
custom_minimum_size = Vector2(300, 64)
layout_mode = 2
theme_type_variation = &"PrimaryButton"

[connection signal="pressed" from="Margin/VBox/Buttons/Secondary_Button" to="." method="_on_secondary_pressed"]
[connection signal="pressed" from="Margin/VBox/Buttons/Primary_Button" to="." method="_on_primary_pressed"]
