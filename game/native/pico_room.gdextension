[configuration]

entry_symbol = "pico_room_library_init"
compatibility_minimum = "4.5"

[libraries]

android.debug.arm64 = "res://game/native/bin/libpicoroom.android.template_debug.arm64.so"
android.release.arm64 = "res://game/native/bin/libpicoroom.android.template_debug.arm64.so"
linux.debug.x86_64 = "res://game/native/bin/libpicoroom.linux.template_debug.x86_64.so"
